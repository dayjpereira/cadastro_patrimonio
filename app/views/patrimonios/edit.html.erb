<% content_for :title, "Cadastro Patrimônio" %>

<div class="card shadow-sm p-4">
  <h1 class="mb-4">Edição de Patrimônio</h1>

  <%= render "form", patrimonio: @patrimonio %>

  <div class="d-flex gap-2 mt-3">
    <%= link_to "Visualizar Patrimônio", @patrimonio, class: "btn btn-outline-secondary" %>
    <%= link_to "Voltar", patrimonios_path, class: "btn btn-outline-secondary" %>
  </div>
</div>


