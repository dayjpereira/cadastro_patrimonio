<p style="color: green"><%= notice %></p>

<div class="container-fluid my-4">
  <div class="row justify-content-center">
    <div class="col-lg-10">
      <div class="table-responsive shadow rounded border">
        <table class="table table-bordered mb-0">
          <thead class="table-light">
            <tr>
              <th colspan="2" class="text-center fs-4 fw-bold py-3">
                <%= @patrimonio.nome %>
              </th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th style="width: 30%;">Número da Placa</th>
              <td><%= @patrimonio.numero_placa %></td>
            </tr>
            <tr>
              <th>Departamento</th>
              <td><%= @patrimonio.departamento.nome %></td>
            </tr>
            <tr>
              <th>Funcionário</th>
              <td><%= @patrimonio.funcionario.present? ? @patrimonio.funcionario.nome : '--' %></td>

            </tr>
            <tr>
              <th>Descrição</th>
              <td><%= @patrimonio.descricao %></td>
            </tr>
            <tr>
              <th>Valor</th>
              <td>R$ <%= number_to_currency(@patrimonio.valor, unit: "", separator: ",", delimiter: ".") %></td>
            </tr>
            <tr>
              <th>Data de Compra</th>
              <td><%= @patrimonio.data_compra.present? ? @patrimonio.data_compra.strftime('%d/%m/%Y') : '--' %></td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="d-flex justify-content-end mt-3">
        <%= link_to "Editar", edit_patrimonio_path(@patrimonio), class: "btn btn-primary me-2" %>
        <%= link_to "Voltar", patrimonios_path, class: "btn btn-secondary" %>
      </div>
    </div>
  </div>
</div>
