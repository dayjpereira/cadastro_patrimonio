<%= form_with(model: patrimonio, local: true) do |form| %>
  <% if patrimonio.errors.any? %>
    <div class="alert alert-danger">
      <h4><%= pluralize(patrimonio.errors.count, "erro") %> proibiram este patrimônio de ser salvo:</h4>
      <ul>
        <% patrimonio.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row mb-3">
    <div class="col-md-6">
      <%= form.label :nome, 'Nome', class: 'form-label' %>
      <%= form.text_field :nome, class: 'form-control' %>
    </div>

    <div class="col-md-6">
      <%= form.label :numero_placa, 'Nº da Placa', class: 'form-label' %>
      <%= form.text_field :numero_placa, class: 'form-control' %>
    </div>
  </div>

  <div class="row mb-3">
    <div class="col-md-6">
      <%= form.label :valor, 'Valor', class: 'form-label' %>
      <%= form.number_field :valor, step: 0.01, class: 'form-control' %>
    </div>

    <div class="col-md-6">
      <%= form.label :data_compra, 'Data de Compra', class: 'form-label' %>
      <%= form.text_field :data_compra, value: form.object.data_compra&.strftime("%d/%m/%Y"), placeholder: "dd/mm/aaaa", class: "form-control data-input" %>
    </div>
  </div>


  <div class="row mb-4">
    <div class="col-md-6">
      <%= form.label :departamento_id, 'Departamento', class: 'form-label' %>
      <%= form.collection_select :departamento_id, Departamento.all, :id, :nome, { prompt: "Selecione um departamento" }, class: 'form-select' %>
    </div>

    <div class="col-md-6">
      <%= form.label :funcionario_id, 'Funcionário', class: 'form-label' %>
      <%= form.collection_select :funcionario_id, Funcionario.all, :id, :nome, { prompt: "Selecione um funcionário" }, class: 'form-select' %>
    </div>
  </div>
          
  <div class="mb-3">
    <%= form.label :descricao, 'Descrição do Produto', class: 'form-label' %>
    <%= form.text_area :descricao, class: 'form-control', rows: 3 %>
  </div>

  <div class="mb-4">
    <%= form.submit patrimonio.new_record? ? "Criar Patrimônio" : "Atualizar Patrimônio", class: "btn btn-primary" %>
  </div>
<% end %>
