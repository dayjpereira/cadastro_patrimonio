<%= form_with(model: funcionario) do |form| %>
  <% if funcionario.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(funcionario.errors.count, "error") %> prohibited this funcionario from being saved:</h2>

      <ul>
        <% funcionario.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row mb-3">
    <div class="col-md-6">
      <%= form.label :nome, 'Nome', class: 'form-label' %>
      <%= form.text_field :nome, class: 'form-control' %>
    </div>
  <div class="row mb-3">
    <div class="col-md-6">
      <%= form.label :departamento_id, 'Departamento', class: 'form-label' %>
      <%= form.collection_select :departamento_id, Departamento.all, :id, :nome, { prompt: "Selecione um departamento" }, class: 'form-select' %>
  </div>
<br>
    <div class="mb-4 mt-4">
      <%= form.submit funcionario.new_record? ? "Criar Funcionário" : "Atualizar Funcionário", class: "btn btn-primary" %>
    </div>

  </div>
<% end %>