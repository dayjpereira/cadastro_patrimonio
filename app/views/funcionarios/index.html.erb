<p style="color: green"><%= notice %></p>

<% content_for :title, "Funcionários" %>

<div class="container mt-4">
  <h1>Funcionários</h1>

  <p style="color: green"><%= notice %></p> 
  <div id="flash">
    <%= render "layouts/flash" %>
  </div>

  <table class="table table-striped">
    <thead>
      <tr>
        <th>Nome</th>
        <th>Departamento</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @funcionarios.each do |funcionario| %>
        <tr id="<%= dom_id(funcionario) %>">

          <td><%= funcionario.nome %></td>
          <td><%= funcionario.departamento.nome if funcionario.departamento %></td>
          <td>
            <div class="d-flex">
              <%= link_to 'Editar', edit_funcionario_path(funcionario), class: 'btn btn-warning btn-sm me-2' %>
              <%= button_to 'Excluir', funcionario_path(funcionario), method: :delete,
                form: { data: { turbo_confirm: 'Tem certeza que deseja excluir este funcionário?' } },
                class: 'btn btn-danger btn-sm' %>
            </div>
          </td>

        </tr>
      <% end %>
    </tbody>
  </table>

  <%= link_to 'Novo Funcionário', new_funcionario_path, class: 'btn btn-success' %>
</div>

