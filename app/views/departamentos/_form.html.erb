<%= form_with(model: departamento) do |form| %>
  <% if departamento.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(departamento.errors.count, "error") %> prohibited this departamento from being saved:</h2>

      <ul>
        <% departamento.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row mb-3">
    <div class="col-md-6">
      <%= form.label :nome, 'Nome', class: 'form-label' %>
      <%= form.text_field :nome, class: 'form-control' %>
    </div>
<br>
    <div class="mb-4 mt-4">
      <%= form.submit departamento.new_record? ? "Criar Departamento" : "Atualizar Departamento", class: "btn btn-primary" %>
    </div>

  </div>
<% end %>
