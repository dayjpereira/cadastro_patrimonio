<% content_for :title, "Cadastro de Patrimônio" %>

<div class="card shadow-sm p-4">
  <h1 class="mb-4">Edição de Departamento</h1>

  <%= render "form", departamento: @departamento %>

  <div class="d-flex gap-2 mt-3">
    <%= link_to "Visualizar Departamento", @departamento, class: "btn btn-outline-secondary" %>
    <%= link_to "Voltar", departamentos_path, class: "btn btn-outline-secondary" %>
  </div>
</div>